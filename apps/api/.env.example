# Copy to .env for local development. NEVER commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://localhost:5432/acp_dev
# Set to true for Supabase / hosted Postgres
DATABASE_SSL=false
REDIS_URL=redis://127.0.0.1:6379
# Generate with: openssl rand -base64 48
JWT_SECRET=
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
WEB_ORIGIN=http://localhost:3100
# Public HTTPS URL Twilio can reach (e.g. an ngrok/cloudflared tunnel in dev)
PUBLIC_API_URL=http://localhost:4000
# Set to false after creating your owner account
ALLOW_SIGNUP=true
LOG_LEVEL=info
