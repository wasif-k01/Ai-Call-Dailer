# ─────────────────────────────────────────────────────────────────────────────
# Production variables for the Railway "api" service.
# Enter them in Railway → api → Variables. Do NOT put real values in this file.
# The "worker" service inherits these automatically via .railway/railway.ts.
# ─────────────────────────────────────────────────────────────────────────────

# Set automatically by .railway/railway.ts (listed here for reference only):
#   NODE_ENV=production
#   RUN_MIGRATIONS_ON_START=false     (migrations run as the pre-deploy step)
#   TRUST_PROXY_HOPS=1
#   REDIS_URL=${{redis.REDIS_URL}}    (Railway-managed Redis, private network)
#   PORT                               (injected by Railway)

# ── Database: Supabase ──────────────────────────────────────────────────────
# Supabase → Project → Connect → "Session pooler" (IPv4, port 5432).
# Do NOT use the "Transaction pooler" (6543); do NOT use the direct db.*.supabase.co host
# (IPv6-only unless you buy the IPv4 add-on).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# Optional but recommended: Supabase → Database → Settings → SSL → "Download certificate".
# Paste the PEM contents; literal "\n" sequences are converted to newlines.
DATABASE_CA_CERT=

# ── App secrets (generate fresh values; never reuse your local ones) ────────
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   ← losing this makes stored integration credentials unreadable; back it up
CREDENTIALS_ENCRYPTION_KEY=

# ── URLs ────────────────────────────────────────────────────────────────────
# Your Vercel production URL (comma-separate several origins if needed)
WEB_ORIGIN=https://<your-app>.vercel.app
# This API's public HTTPS URL. Twilio webhook URLs and wss:// URLs are built from it,
# and Twilio signature validation depends on it matching exactly.
PUBLIC_API_URL=https://<your-api-service>.up.railway.app

# Leave true until you've created the owner account, then set to false.
ALLOW_SIGNUP=true
LOG_LEVEL=info

# ── Supabase Storage (call recordings; used from Phase 7) ───────────────────
# Supabase → Project Settings → API. The service-role key bypasses RLS:
# it lives ONLY on the backend and must never be given to the frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=call-recordings

# ── OpenAI / Twilio ─────────────────────────────────────────────────────────
# Not environment variables. Entered by the owner in the dashboard
# (Integrations & API Settings) and stored AES-256-GCM encrypted in the database.
